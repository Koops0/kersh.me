---
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#050709" media="(prefers-color-scheme: dark)" />
        <link rel="icon" type="image/png" href="/favicon.png?v=1" />
        <meta name="generator" content={Astro.generator} />
        <title>Kershan Arulneswaran</title>
        <ClientRouter />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Red+Hat+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body>
        <div id="site-loader" class="site-loader" role="status" aria-label="Loading site">
            <div class="loader-mark" aria-hidden="true">k.a.</div>
            <div class="loader-track" aria-hidden="true"><span></span></div>
        </div>
        <noscript><style>.site-loader { display: none !important; }</style></noscript>
        <slot />

        <script>
            const minimumLoaderTime = 360;
            let loaderShownAt = performance.now();
            let loaderCycle = 0;

            function normalizeRoute(pathname: string) {
                return pathname === '/' ? pathname : pathname.replace(/\/$/, '');
            }

            const pageSquircles = new Map([
                ['/about', 'strawberry'],
                ['/blog', 'grape'],
                ['/experience', 'bondi']
            ]);

            function getMainPageTransition(event?: Event) {
                const navigation = event as Event & { from?: URL; to?: URL };
                if (!navigation.from || !navigation.to) return;

                const from = normalizeRoute(navigation.from.pathname);
                const to = normalizeRoute(navigation.to.pathname);
                if (from === '/' && pageSquircles.has(to)) {
                    return { shape: pageSquircles.get(to), entering: true };
                }
                if (to === '/' && pageSquircles.has(from)) {
                    return { shape: pageSquircles.get(from), entering: false };
                }
            }

            function isSectionChange(event?: Event) {
                const navigation = event as Event & { from?: URL; to?: URL };
                if (!navigation.from || !navigation.to) return false;

                const from = normalizeRoute(navigation.from.pathname);
                const to = normalizeRoute(navigation.to.pathname);
                return from !== to && pageSquircles.has(from) && pageSquircles.has(to);
            }

            function isLeavingKoops(event?: Event) {
                const navigation = event as Event & { from?: URL; to?: URL };
                if (!navigation.from || !navigation.to) return false;

                const from = normalizeRoute(navigation.from.pathname);
                const to = normalizeRoute(navigation.to.pathname);
                return from === '/blog'
                    && from !== to
                    && document.documentElement.classList.contains('koops-blog-active');
            }

            function showLoader(event?: Event) {
                const leavingKoops = isLeavingKoops(event);

                if (!leavingKoops) {
                    const mainPageTransition = getMainPageTransition(event);
                    if (mainPageTransition) {
                        const navigation = event as Event & { from?: URL; direction?: string };
                        const direction = `${mainPageTransition.shape}-${mainPageTransition.entering ? 'in' : 'out'}`;
                        navigation.direction = direction;
                        if (mainPageTransition.entering) {
                            document.documentElement.classList.add('is-main-departing');
                        } else {
                            document.documentElement.classList.add('is-page-departing');
                        }
                        return;
                    }

                    if (isSectionChange(event)) {
                        const navigation = event as Event & { direction?: string };
                        navigation.direction = 'section-change';
                        document.documentElement.classList.add('is-section-departing');
                        document.querySelector<HTMLElement>('.page-squircle')
                            ?.style.setProperty('view-transition-name', 'cinema-page-squircle');
                        return;
                    }
                }

                loaderCycle += 1;
                loaderShownAt = performance.now();
                const loader = document.getElementById('site-loader');
                if (!loader) return;

                const loaderMark = loader.querySelector<HTMLElement>('.loader-mark');
                loader.classList.toggle('is-koops-exit', leavingKoops);
                if (loaderMark) loaderMark.textContent = leavingKoops ? 'Returning to Kersh' : 'k.a.';

                loader.hidden = false;
                loader.removeAttribute('aria-hidden');
                requestAnimationFrame(() => loader.classList.remove('is-hidden'));
            }

            async function hideLoader() {
                const cycle = loaderCycle;
                await document.fonts?.ready;

                const elapsed = performance.now() - loaderShownAt;
                const remaining = Math.max(0, minimumLoaderTime - elapsed);

                window.setTimeout(() => {
                    if (cycle !== loaderCycle) return;
                    const loader = document.getElementById('site-loader');
                    if (!loader) return;

                    loader.classList.add('is-hidden');
                    loader.setAttribute('aria-hidden', 'true');

                    window.setTimeout(() => {
                        if (cycle === loaderCycle) loader.hidden = true;
                    }, 200);
                }, remaining);
            }

            document.addEventListener('astro:before-preparation', showLoader);
            document.addEventListener('astro:page-load', hideLoader);

            if (document.readyState === 'complete') {
                void hideLoader();
            } else {
                window.addEventListener('load', () => void hideLoader(), { once: true });
            }

            if (import.meta.env.PROD && 'serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    void navigator.serviceWorker.register('/sw.js');
                }, { once: true });
            }

            const squircleMedia = window.matchMedia(
                '(hover: hover) and (pointer: fine) and (min-width: 821px) and (prefers-reduced-motion: no-preference)'
            );
            let pointerClientX = -1;
            let pointerClientY = -1;
            let squircleFrame = 0;
            let trackedSquircle: HTMLElement | undefined;
            let grapeArrivalTimer = 0;
            let aboutRevealTimer = 0;

            function clearSquircle(shape: HTMLElement) {
                shape.classList.remove('is-pointer-active');
                shape.style.removeProperty('--deform-radius');
            }

            function reactToSquircle() {
                squircleFrame = 0;
                const shapes = Array.from(document.querySelectorAll<HTMLElement>('.bg-shape'));

                if (!squircleMedia.matches || pointerClientX < 0 || pointerClientY < 0) {
                    shapes.forEach(clearSquircle);
                    return;
                }

                let hoveredShape: HTMLElement | undefined;
                let closestDistance = Number.POSITIVE_INFINITY;

                shapes.forEach((shape) => {
                    const bounds = shape.getBoundingClientRect();
                    const normalizedX = (pointerClientX - (bounds.left + bounds.width / 2)) / (bounds.width / 2);
                    const normalizedY = (pointerClientY - (bounds.top + bounds.height / 2)) / (bounds.height / 2);
                    const squircleDistance = normalizedX ** 4 + normalizedY ** 4;

                    if (squircleDistance <= 1 && squircleDistance < closestDistance) {
                        closestDistance = squircleDistance;
                        hoveredShape = shape;
                    }
                });

                if (hoveredShape) trackedSquircle = hoveredShape;
                if (!trackedSquircle?.isConnected) return;

                const trackedBounds = trackedSquircle.getBoundingClientRect();
                const relativeX = (pointerClientX - (trackedBounds.left + trackedBounds.width / 2)) / (trackedBounds.width / 2);
                const relativeY = (pointerClientY - (trackedBounds.top + trackedBounds.height / 2)) / (trackedBounds.height / 2);
                const activeX = Math.tanh(relativeX * 0.9);
                const activeY = Math.tanh(relativeY * 0.9);

                const clampRadius = (value: number) => Math.min(78, Math.max(22, value));
                const topLeft = clampRadius(50 + (activeX + activeY) * 16);
                const topRight = clampRadius(50 + (-activeX + activeY) * 16);
                const bottomRight = clampRadius(50 + (-activeX - activeY) * 16);
                const bottomLeft = clampRadius(50 + (activeX - activeY) * 16);
                const verticalTopLeft = clampRadius(50 + (activeX * 0.7 + activeY) * 18);
                const verticalTopRight = clampRadius(50 + (-activeX * 0.7 + activeY) * 18);
                const verticalBottomRight = clampRadius(50 + (-activeX * 0.7 - activeY) * 18);
                const verticalBottomLeft = clampRadius(50 + (activeX * 0.7 - activeY) * 18);

                trackedSquircle.classList.add('is-pointer-active');
                trackedSquircle.style.setProperty(
                    '--deform-radius',
                    `${topLeft}% ${topRight}% ${bottomRight}% ${bottomLeft}% / ${verticalTopLeft}% ${verticalTopRight}% ${verticalBottomRight}% ${verticalBottomLeft}%`
                );
            }

            function moveSquircles(event: PointerEvent) {
                if (!squircleMedia.matches) return;
                pointerClientX = event.clientX;
                pointerClientY = event.clientY;
                if (!squircleFrame) squircleFrame = requestAnimationFrame(reactToSquircle);
            }

            function resetSquircles() {
                pointerClientX = -1;
                pointerClientY = -1;
                trackedSquircle = undefined;
                document.querySelectorAll<HTMLElement>('.bg-shape').forEach(clearSquircle);
            }

            function settleArrivingSquircle() {
                const direction = document.documentElement.getAttribute('data-astro-transition');
                const shape = direction?.match(/^(strawberry|grape|bondi)-(?:in|out)$/)?.[1];
                if (!shape && direction !== 'section-change') return;

                const squircle = document.querySelector<HTMLElement>(
                    direction === 'section-change'
                        ? '.page-squircle[data-astro-transition-scope]'
                        : `[data-squircle="${shape}"][data-astro-transition-scope]`
                );
                if (!squircle) return;

                window.clearTimeout(grapeArrivalTimer);
                squircle.classList.add('is-route-arrival');
                grapeArrivalTimer = window.setTimeout(() => {
                    squircle.classList.remove('is-route-arrival');
                }, direction === 'section-change' ? 880 : 800);
            }

            function prepareRouteReveal(event: Event) {
                const transition = event as Event & {
                    direction?: string;
                    newDocument?: Document;
                    viewTransition?: { finished: Promise<unknown> };
                };

                const arrivingAtPage = /^(strawberry|grape|bondi)-in$/.test(transition.direction ?? '');
                const arrivingAtMain = /^(strawberry|grape|bondi)-out$/.test(transition.direction ?? '');
                const changingSection = transition.direction === 'section-change';
                if (
                    (!arrivingAtPage && !arrivingAtMain && !changingSection) ||
                    window.matchMedia('(prefers-reduced-motion: reduce)').matches
                ) return;

                if (changingSection) {
                    const arrivingClass = 'is-section-arriving';
                    const revealingClass = 'is-section-revealing';
                    transition.newDocument?.querySelector<HTMLElement>('.page-squircle')
                        ?.style.setProperty('view-transition-name', 'cinema-page-squircle');
                    transition.newDocument?.documentElement.classList.add(arrivingClass);

                    const revealSection = () => {
                        const root = document.documentElement;
                        if (!root.classList.contains(arrivingClass)) return;

                        root.classList.add(revealingClass);
                        document.querySelector<HTMLElement>('.page-squircle')
                            ?.style.removeProperty('view-transition-name');
                        window.clearTimeout(aboutRevealTimer);
                        aboutRevealTimer = window.setTimeout(() => {
                            root.classList.remove(arrivingClass, revealingClass);
                        }, 620);
                    };

                    if (transition.viewTransition) {
                        void transition.viewTransition.finished.then(revealSection, revealSection);
                    } else {
                        window.setTimeout(revealSection, 840);
                    }
                    return;
                }

                const arrivingClass = arrivingAtPage ? 'is-page-arriving' : 'is-main-arriving';
                const revealingClass = arrivingAtPage ? 'is-page-revealing' : 'is-main-revealing';
                transition.newDocument?.documentElement.classList.add(arrivingClass);

                const reveal = () => {
                    const root = document.documentElement;
                    if (!root.classList.contains(arrivingClass)) return;

                    root.classList.add(revealingClass);
                    if (arrivingAtMain) window.dispatchEvent(new Event('site:main-reveal'));
                    window.clearTimeout(aboutRevealTimer);
                    aboutRevealTimer = window.setTimeout(() => {
                        root.classList.remove(arrivingClass, revealingClass);
                    }, 720);
                };

                if (transition.viewTransition) {
                    void transition.viewTransition.finished.then(reveal, reveal);
                } else {
                    window.setTimeout(reveal, 760);
                }
            }

            window.addEventListener('pointermove', moveSquircles, { passive: true });
            squircleMedia.addEventListener('change', resetSquircles);
            document.addEventListener('astro:before-swap', prepareRouteReveal);
            document.addEventListener('astro:after-swap', settleArrivingSquircle);
            document.addEventListener('astro:page-load', () => {
                document.documentElement.classList.remove(
                    'is-main-departing',
                    'is-page-departing',
                    'is-section-departing'
                );
                resetSquircles();
            });
        </script>
    </body>
</html>

<style is:global>
:root {
    color-scheme: light dark;
    --font-display: 'Archivo', 'Arial Black', sans-serif;
    --font-body: 'Red Hat Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
    --ink: #172126;
    --muted-ink: rgb(23 33 38 / 68%);
    --accent: #006b7c;
    --canvas: #f4f1ea;
    --backdrop: radial-gradient(ellipse at 50% 35%, #ffffff 0%, #f4f1ea 55%, #e6e1d7 100%);
    --loader-track: rgb(23 33 38 / 18%);
    --icon-hover: rgb(23 33 38 / 8%);
    --shape-highlight: rgb(255 255 255 / 62%);
    --shape-shade: rgb(28 35 39 / 18%);
    --shape-shadow: rgb(42 48 51 / 18%);
}

@media (prefers-color-scheme: dark) {
    :root {
        --ink: #f3f7f6;
        --muted-ink: rgb(243 247 246 / 68%);
        --accent: #72d6e5;
        --canvas: #050709;
        --backdrop: radial-gradient(ellipse at 50% 35%, #121a20 0%, #080c0f 52%, #030405 100%);
        --loader-track: rgb(243 247 246 / 18%);
        --icon-hover: rgb(255 255 255 / 10%);
        --shape-highlight: rgb(255 255 255 / 42%);
        --shape-shade: rgb(0 0 0 / 28%);
        --shape-shadow: rgb(0 0 0 / 28%);
    }
}

html {
    scroll-behavior: auto;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    background-color: var(--canvas);
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-width: 0;
}

body {
    min-height: 100vh;
    min-height: 100dvh;
    font-family: var(--font-body);
    line-height: 1.5;
    color: var(--ink);
    background-color: var(--canvas);
    background-image: var(--backdrop);
    background-attachment: fixed;
    position: relative;
    overflow-x: hidden;
    overscroll-behavior-x: none;
}

h1,
h2,
h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-variation-settings: 'wdth' 125, 'wght' 800;
}

button,
input,
textarea,
select {
    font: inherit;
}

.site-loader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    color: var(--ink);
    background: var(--canvas);
    opacity: 1;
    transition: opacity 0.18s ease;
}

.site-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
}

.loader-mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-variation-settings: 'wdth' 125, 'wght' 800;
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: 0.12em;
    color: var(--ink);
}

@supports (-webkit-text-stroke: 1px black) {
    .loader-mark {
        color: transparent;
        -webkit-text-stroke: 1.25px var(--ink);
        paint-order: stroke fill;
    }
}

.loader-track {
    width: 7rem;
    height: 1px;
    overflow: hidden;
    background: var(--loader-track);
}

.loader-track span {
    width: 100%;
    height: 100%;
    display: block;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    animation: loader-progress 0.9s ease-in-out infinite;
}

@keyframes loader-progress {
    0% { transform: scaleX(0); }
    55% { transform: scaleX(1); transform-origin: left; }
    56% { transform: scaleX(1); transform-origin: right; }
    100% { transform: scaleX(0); transform-origin: right; }
}

@supports (overflow: clip) {
    body {
        overflow-x: clip;
    }
}

img,
svg {
    max-width: 100%;
}

a,
button {
    -webkit-tap-highlight-color: transparent;
}

:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}

.section {
    position: relative;
    z-index: 1;
    overflow: visible;
}

.bg-shape {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    opacity: 0.66;
    box-shadow:
        inset 0 1px 0 var(--shape-highlight),
        inset -1.5rem -2rem 3rem var(--shape-shade),
        0 1.5rem 5rem var(--shape-shadow);
    transition: border-radius 140ms ease-out;
}

.bg-shape.is-pointer-active {
    border-radius: var(--deform-radius) !important;
}

.bg-shape.is-route-arrival {
    animation: none !important;
    transition: none !important;
    transform: translate(0, 0) scale(1) rotate(0deg);
    border-radius: 63% 37% 54% 46% / 55% 48% 52% 45% !important;
}

::view-transition-group(cinema-page-squircle) {
    z-index: 20;
}

/* Main ↔ page transitions use the matching homepage squircle. */
:is([data-astro-transition='strawberry-in'], [data-astro-transition='strawberry-out'])::view-transition-group(cinema-strawberry),
:is([data-astro-transition='grape-in'], [data-astro-transition='grape-out'])::view-transition-group(cinema-grape),
:is([data-astro-transition='bondi-in'], [data-astro-transition='bondi-out'])::view-transition-group(cinema-bondi) {
    animation-duration: 760ms;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    z-index: 20;
}

:is([data-astro-transition='strawberry-in'], [data-astro-transition='strawberry-out'])::view-transition-image-pair(cinema-strawberry),
:is([data-astro-transition='grape-in'], [data-astro-transition='grape-out'])::view-transition-image-pair(cinema-grape),
:is([data-astro-transition='bondi-in'], [data-astro-transition='bondi-out'])::view-transition-image-pair(cinema-bondi) {
    overflow: hidden;
    opacity: 0.66;
    box-shadow:
        inset 0 1px 0 var(--shape-highlight),
        inset -1.5rem -2rem 3rem var(--shape-shade),
        0 1.5rem 5rem var(--shape-shadow);
    animation: cinema-grape-deform 760ms cubic-bezier(0.76, 0, 0.24, 1) both;
}

:is([data-astro-transition='strawberry-in'], [data-astro-transition='strawberry-out'])::view-transition-image-pair(cinema-strawberry) {
    background: radial-gradient(circle at 30% 24%, #ffd0dd 0%, #e8587b 25%, #9f2949 66%, #501326 100%);
}

:is([data-astro-transition='grape-in'], [data-astro-transition='grape-out'])::view-transition-image-pair(cinema-grape) {
    background: radial-gradient(circle at 30% 24%, #e1d0ff 0%, #8967af 25%, #553577 66%, #2c193f 100%);
}

:is([data-astro-transition='bondi-in'], [data-astro-transition='bondi-out'])::view-transition-image-pair(cinema-bondi) {
    background: radial-gradient(circle at 30% 24%, #b7f6ff 0%, #16b7d1 25%, #006b84 66%, #003947 100%);
}

[data-astro-transition='strawberry-out']::view-transition-image-pair(cinema-strawberry),
[data-astro-transition='grape-out']::view-transition-image-pair(cinema-grape),
[data-astro-transition='bondi-out']::view-transition-image-pair(cinema-bondi) {
    animation-direction: reverse;
}

:is([data-astro-transition='strawberry-in'], [data-astro-transition='strawberry-out'])::view-transition-old(cinema-strawberry),
:is([data-astro-transition='strawberry-in'], [data-astro-transition='strawberry-out'])::view-transition-new(cinema-strawberry),
:is([data-astro-transition='grape-in'], [data-astro-transition='grape-out'])::view-transition-old(cinema-grape),
:is([data-astro-transition='grape-in'], [data-astro-transition='grape-out'])::view-transition-new(cinema-grape),
:is([data-astro-transition='bondi-in'], [data-astro-transition='bondi-out'])::view-transition-old(cinema-bondi),
:is([data-astro-transition='bondi-in'], [data-astro-transition='bondi-out'])::view-transition-new(cinema-bondi) {
    animation: none;
    opacity: 0;
    mix-blend-mode: normal;
}

:is(
    [data-astro-transition='strawberry-in'],
    [data-astro-transition='strawberry-out'],
    [data-astro-transition='grape-in'],
    [data-astro-transition='grape-out'],
    [data-astro-transition='bondi-in'],
    [data-astro-transition='bondi-out']
)::view-transition-old(root),
:is(
    [data-astro-transition='strawberry-in'],
    [data-astro-transition='strawberry-out'],
    [data-astro-transition='grape-in'],
    [data-astro-transition='grape-out'],
    [data-astro-transition='bondi-in'],
    [data-astro-transition='bondi-out']
)::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
}

:is([data-astro-transition$='-in'], [data-astro-transition$='-out'])::view-transition-old(root) {
    opacity: 1;
}

:is([data-astro-transition$='-in'], [data-astro-transition$='-out'])::view-transition-new(root) {
    opacity: 0;
}

[data-astro-transition='section-change']::view-transition-old(root),
[data-astro-transition='section-change']::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
}

[data-astro-transition='section-change']::view-transition-old(root) {
    opacity: 1;
}

[data-astro-transition='section-change']::view-transition-new(root) {
    opacity: 0;
}

html.is-section-departing .site-header,
html.is-section-arriving .site-header {
    view-transition-name: cinema-full-header;
}

::view-transition-group(cinema-full-header) {
    animation: none;
    z-index: 100;
}

::view-transition-old(cinema-full-header),
::view-transition-new(cinema-full-header) {
    animation: none;
    mix-blend-mode: normal;
}

::view-transition-old(cinema-full-header) {
    opacity: 1;
}

::view-transition-new(cinema-full-header) {
    opacity: 0;
}

/* Section changes are deliberately sequential: color first, geometry second. */
[data-astro-transition='section-change']::view-transition-group(cinema-page-squircle) {
    animation-delay: 340ms;
    animation-duration: 500ms;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    animation-fill-mode: both;
}

[data-astro-transition='section-change']::view-transition-image-pair(cinema-page-squircle) {
    overflow: hidden;
    background: transparent;
    opacity: 1;
    box-shadow: none;
    animation: section-squircle-settle 500ms 340ms cubic-bezier(0.76, 0, 0.24, 1) both;
}

[data-astro-transition='section-change']::view-transition-old(cinema-page-squircle) {
    animation: section-squircle-color-out 340ms ease-in-out both;
    opacity: 1;
}

[data-astro-transition='section-change']::view-transition-new(cinema-page-squircle) {
    animation: section-squircle-color-in 340ms ease-in-out both;
    opacity: 1;
}

::view-transition-group(cinema-header-links) {
    animation: none;
    z-index: 100;
}

::view-transition-old(cinema-header-links),
::view-transition-new(cinema-header-links) {
    animation: none;
    mix-blend-mode: normal;
}

[data-astro-transition$='-in']::view-transition-new(cinema-header-links) {
    animation: header-links-fade-in 760ms cubic-bezier(0.76, 0, 0.24, 1) both;
}

[data-astro-transition$='-out']::view-transition-old(cinema-header-links) {
    animation: header-links-fade-out 760ms cubic-bezier(0.76, 0, 0.24, 1) both;
}

