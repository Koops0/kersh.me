---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.svelte';
import About from '../components/About.svelte';
---

<Layout>
    <Header client:load currentPage="about" />

    <main>
        <!-- About Section with Grape blob -->
        <section class="section about-section">
            <div class="bg-shape grape about-blob"></div>
            <About client:load />
        </section>
    </main>
    
    <Footer client:load />
</Layout>

<style>
.about-section {
    position: relative;
    overflow: hidden;
}

/* Grape blob - large, centered */
.about-blob {
    width: min(75vw, 50rem);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 45% 55% 60% 40% / 50% 35% 65% 50%;
    animation: float 25s ease-in-out infinite, morph 18s ease-in-out infinite;
}

@media (max-width: 520px) {
    .about-blob {
        width: min(78vw, 28rem);
    }
}
</style>
