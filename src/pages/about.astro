---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.svelte';
import About from '../components/About.svelte';
---

<Layout>
    <Header client:idle={{ timeout: 350 }} currentPage="about" />

    <main>
        <!-- About Section with Strawberry squircle -->
        <section class="section about-section">
            <div class="bg-shape strawberry page-squircle about-blob" data-squircle="strawberry" transition:name="cinema-strawberry"></div>
            <About />
        </section>
    </main>
    
    <Footer />
</Layout>

<style>
.about-section {
    position: relative;
    overflow: visible;
}

/* The transition must not alter this destination size. */
.about-blob {
    position: fixed;
    width: min(75vw, 50rem);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 45% 55% 60% 40% / 50% 35% 65% 50%;
    animation: float 25s ease-in-out infinite;
}

@media (min-width: 1800px) {
    .about-blob {
        width: min(84vw, 120vh);
    }
}

@media (max-width: 520px) {
    .about-blob {
        width: min(78vw, 28rem);
    }
}
</style>
