---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.svelte';
import Blog from '../components/Blog.svelte';
---

<Layout>
    <Header client:load currentPage="blog" />

    <main>
        <section class="section blog-section">
            <div class="bg-shape grape page-squircle blog-blob" data-squircle="grape" transition:name="cinema-grape"></div>
            <Blog client:load />
        </section>
    </main>

    <Footer client:load />
</Layout>

<style>
.blog-section {
    position: relative;
    overflow: visible;
}

.blog-blob {
    position: fixed;
    width: min(75vw, 50rem);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 45% 55% 60% 40% / 50% 35% 65% 50%;
    animation: float 25s ease-in-out infinite, morph 18s ease-in-out infinite;
}

@media (max-width: 520px) {
    .blog-blob {
        width: min(78vw, 28rem);
    }
}
</style>
