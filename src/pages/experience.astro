---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.svelte';
import Footer from '../components/Footer.svelte';
import Experience from '../components/Experience.svelte';
---

<Layout>
    <Header client:idle={{ timeout: 350 }} currentPage="experience" />

    <main>
        <section class="section experience-section">
            <div class="bg-shape bondi-blue page-squircle experience-blob" data-squircle="bondi" transition:name="cinema-bondi"></div>
            <Experience />
        </section>
    </main>

    <Footer />
</Layout>

<style>
.experience-section {
    position: relative;
    overflow: visible;
}

.experience-blob {
    position: fixed;
    width: min(75vw, 50rem);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 45% 55% 60% 40% / 50% 35% 65% 50%;
    animation: float 25s ease-in-out infinite;
}

@media (min-width: 1800px) {
    .experience-blob {
        width: min(84vw, 120vh);
    }
}

@media (max-width: 520px) {
    .experience-blob {
        width: min(78vw, 28rem);
    }
}
</style>
