---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.svelte';
import Header from '../components/Header.svelte';
import Intro from '../components/Intro.svelte';
---
<Layout>
    <Header client:load isHomePage={true} currentPage="home" />

    <main>
        <!-- Intro Section with all 5 blobs -->
        <section class="section intro-section" id="intro">
            <div class="bg-shape bondi-blue blob-1" data-squircle="bondi" transition:name="cinema-bondi"></div>
            <div class="bg-shape strawberry blob-2" data-squircle="strawberry" transition:name="cinema-strawberry"></div>
            <div class="bg-shape lime blob-3" transition:name="cinema-lime"></div>
            <div class="bg-shape tangerine blob-4" transition:name="cinema-tangerine"></div>
            <div class="bg-shape grape blob-5" data-squircle="grape" transition:name="cinema-grape"></div>
            <Intro client:load />
        </section>
    </main>
    
    <Footer client:load />
</Layout>

<style>
section {
    scroll-margin-top: 0;
    padding: 0;
    margin: 0;
}

.intro-section {
    position: relative;
    overflow: visible;
    min-height: calc(100vh - 7rem);
    min-height: calc(100svh - 7rem);
}

/* Intro blobs */
.blob-1 {
    width: clamp(20rem, 48vw, 37.5rem);
    aspect-ratio: 1;
    top: clamp(2rem, 4vw, 4rem);
    right: clamp(2rem, 5vw, 5rem);
    border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%;
    animation: float 20s ease-in-out infinite, morph 12s ease-in-out infinite;
}

.blob-2 {
    width: clamp(16rem, 36vw, 28rem);
    aspect-ratio: 1;
    bottom: clamp(2rem, 5vw, 5rem);
    left: clamp(2rem, 5vw, 5rem);
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    animation: float 15s ease-in-out infinite reverse, morph 10s ease-in-out infinite;
}

.blob-3 {
    width: clamp(13rem, 28vw, 22rem);
    aspect-ratio: 1;
    bottom: clamp(2rem, 8vw, 7rem);
    right: clamp(-5rem, 5vw, 6rem);
    border-radius: 15% 85% 20% 80% / 85% 15% 85% 15%;
    animation: pulse 18s ease-in-out infinite, morph 14s ease-in-out infinite;
}

.blob-4 {
    width: clamp(11rem, 22vw, 18rem);
    aspect-ratio: 1;
    top: clamp(5rem, 12vw, 10rem);
    left: clamp(2rem, 5vw, 5rem);
    border-radius: 73% 27% 46% 54% / 38% 68% 32% 62%;
    animation: float 22s ease-in-out infinite, morph 16s ease-in-out infinite;
}

.blob-5 {
    width: clamp(12rem, 25vw, 20rem);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 45% 55% 60% 40% / 50% 35% 65% 50%;
    animation: float 19s ease-in-out infinite, morph 13s ease-in-out infinite;
}

@media (max-width: 820px) {
    .intro-section {
        min-height: calc(100vh - 6rem);
        min-height: calc(100svh - 6rem);
    }

    .blob-1 {
        width: min(70vw, 20rem);
        top: 1.5rem;
        right: 4vw;
    }

    .blob-2 {
        width: min(62vw, 16rem);
        bottom: 2rem;
        left: 4vw;
    }

    .blob-3 {
        width: min(54vw, 13rem);
        right: 5vw;
    }

    .blob-4 {
        width: min(48vw, 11rem);
        left: 4vw;
    }

    .blob-5 {
        width: min(56vw, 12rem);
    }
}

@media (max-width: 520px) {
    .blob-3 {
        right: 5vw;
    }
}

@media (max-height: 560px) and (orientation: landscape) {
    .intro-section {
        min-height: auto;
    }
}
</style>
